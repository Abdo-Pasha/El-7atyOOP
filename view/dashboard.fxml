<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DashboardController"
            prefWidth="900"
            prefHeight="600"
            style="-fx-background-color: #F8F5F0;">

    <!-- Header -->

    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding: 20;
                     -fx-background-color: #7A1F2B;">

            <Label text="EL7ATY"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label fx:id="welcomeLabel"
                   text="Welcome!"
                   HBox.hgrow="ALWAYS"
                   style="-fx-font-size: 18px;
                          -fx-text-fill: white;"/>

            <Button text="Logout"
                    onAction="#logout"/>
        </HBox>
    </top>


    <!-- Main Content -->

    <center>
        <VBox spacing="20"
              style="-fx-padding: 30;">

            <Label text="Customer Dashboard"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #333333;"/>


            <!-- Customer Information -->

            <HBox spacing="20">

                <VBox spacing="10"
                      prefWidth="400"
                      style="-fx-background-color: white;
                             -fx-background-radius: 15;
                             -fx-padding: 20;
                             -fx-border-color: #E0DDD8;
                             -fx-border-radius: 15;">

                    <Label text="Customer Information"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Separator/>

                    <Label fx:id="usernameLabel"
                           text="Username:"/>

                    <Label fx:id="phoneLabel"
                           text="Phone:"/>

                    <Label fx:id="dobLabel"
                           text="Date of Birth:"/>

                    <Label fx:id="dietLabel"
                           text="Dietary Preference:"/>

                </VBox>


                <!-- Loyalty Points -->

                <VBox spacing="10"
                      alignment="CENTER"
                      prefWidth="250"
                      style="-fx-background-color: white;
                             -fx-background-radius: 15;
                             -fx-padding: 20;
                             -fx-border-color: #E0DDD8;
                             -fx-border-radius: 15;">

                    <Label text="Loyalty Points"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="loyaltyLabel"
                           text="0"
                           style="-fx-font-size: 40px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #7A1F2B;"/>

                    <Label text="Points"/>
                </VBox>

            </HBox>


            <!-- Actions -->

            <Label text="What would you like to do?"
       style="-fx-font-size: 20px;
              -fx-font-weight: bold;"/>

    <HBox spacing="15">

        <Button text="Reserve a Table"
                onAction="#openReservations"
                prefWidth="180"
                prefHeight="50"/>

        <Button text="My Reservations"
                onAction="#openReservationsHistory"
                prefWidth="180"
                prefHeight="50"/>

        <Button text="Order Food"
                onAction="#openMenu"
                prefWidth="180"
                prefHeight="50"/>

    </HBox>

        </VBox>
    </center>

</BorderPane>