<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CheckoutController"
      spacing="15"
      style="-fx-padding: 25;">

    <Label text="Checkout"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
              
    <Label fx:id="statusLabel"
           text="Status: PLACED"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label text="Your Order"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <VBox fx:id="orderContainer"
          spacing="8"/>

    <Separator/>

    <Label fx:id="subtotalLabel"
           text="Subtotal: 0.00 EGP"/>

    <Label fx:id="taxLabel"
           text="Tax: 0.00 EGP"/>

    <Label fx:id="serviceChargeLabel"
           text="Service Charge: 0.00 EGP"/>

    <Label fx:id="totalLabel"
           text="Total: 0.00 EGP"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Separator/>

    <Label text="Payment Method"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <VBox spacing="8">

        <RadioButton fx:id="cashRadio"
                     text="Cash"/>

        <RadioButton fx:id="creditCardRadio"
                     text="Credit Card"/>

        <RadioButton fx:id="debitCardRadio"
                     text="Debit Card"/>

        <RadioButton fx:id="walletRadio"
                     text="Digital Wallet"/>

    </VBox>

    <Button fx:id="startPreparingButton"
        text="Start Preparing"
        onAction="#startPreparing"
        maxWidth="250"/>

	<Button fx:id="markServedButton"
        text="Mark Served"
        onAction="#markServed"
        maxWidth="250"/>

    <Button fx:id="confirmPaymentButton"
        text="Confirm Payment"
        onAction="#confirmPayment"
        maxWidth="250"/>

    <Label fx:id="feedbackLabel"
           text=""/>

</VBox>