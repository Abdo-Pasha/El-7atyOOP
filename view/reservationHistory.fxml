<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ReservationHistoryController" prefWidth="900" prefHeight="650" style="-fx-background-color: #F8F5F0;">

    <top>
        <VBox spacing="8" style="-fx-padding: 20; -fx-background-color: #7A1F2B;">
            <Label text="My Reservations" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="View and manage your reservations" style="-fx-font-size: 14px; -fx-text-fill: white;"/>
            <Button text="Back to Dashboard" onAction="#backToDashboard" prefWidth="180" prefHeight="40"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="reservationContainer" spacing="15" style="-fx-padding: 25;"/>
            </content>
        </ScrollPane>
    </center>

</BorderPane>